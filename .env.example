# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides for the WTX catalog.
# Defaults to the stage buyer API, which serves search without auth.
# WTX_GRAPHQL_URL=https://stage-buyer-api.worldtradex.com/graphQL

# Sent as the Authorization / IdToken headers if the endpoint starts
# requiring them. Search is public on stage, so both are optional.
# WTX_AUTH_TOKEN=
# WTX_ID_TOKEN=

# The API does not return a currency; this is used for formatting only.
# PRODUCT_CURRENCY=USD

# Makes product cards clickable. Must contain {id}.
# WTX_PRODUCT_URL_TEMPLATE=https://stage-buyer.worldtradex.com/product/{id}

# Optional model override, defaults to claude-opus-5
# ANTHROPIC_MODEL=claude-opus-5
